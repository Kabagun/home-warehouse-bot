# Reference only: the service does not load this file automatically.

# Private, persistent data directory. It must already contain the existing database.
APP_DATA_DIR=/path/to/private/persistent-data

# Optional. If omitted, the service uses
# $APP_DATA_DIR/home_warehouse_bot.sqlite3. Any override must be directly under APP_DATA_DIR.
DATABASE_PATH=/path/to/private/persistent-data/home_warehouse_bot.sqlite3

# Set by the hosting platform.
HOST=0.0.0.0
PORT=8000
MCP_RELEASE_ID=replace-with-safe-release-id

# Path to a protected first-run JSON secret file; provision it outside the repository.
MCP_BOOTSTRAP_FILE=/path/to/protected/mcp-bootstrap.json

# Optional public HTTPS origin (scheme and host only; no path).
MCP_PUBLIC_URL=https://warehouse.example.invalid

# Stdio only: the registered local user ID. HTTP identity comes from bootstrap JSON.
MCP_USER_ID=1
