[Unit]
Description=Home Warehouse Telegram Bot
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/home-warehouse-bot
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStart=/path/to/home-warehouse-bot/.venv/bin/python /path/to/home-warehouse-bot/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
